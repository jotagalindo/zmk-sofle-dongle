#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35    // 10

#include "keys_es.h"
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    macros {
        shift_MB3: shift_MB3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_MB3";
        };
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC           &kp N1        &kp N2        &kp N3    &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9      &kp N0          &kp BACKSPACE
&kp TAB           &kp ES_Q      &kp ES_W      &kp ES_E  &kp ES_R      &kp ES_T     &kp DOWN_ARROW   &kp ES_Y   &kp ES_U      &kp ES_I      &kp ES_O    &kp ES_P        &kp ES_QUESTION
&kp LSHIFT        &kp ES_A      &kp ES_S      &kp ES_D  &kp ES_F      &kp ES_G     &kp LEFT_ARROW   &kp ES_H   &kp ES_J      &kp ES_K      &kp ES_L    &kp ES_N_TILDE  &kp ES_ACUTE
&kp LEFT_CONTROL  &kp ES_Z      &kp ES_X      &kp ES_C  &kp ES_V      &kp ES_B     &kp RIGHT_ARROW  &kp ES_N   &kp ES_M      &kp ES_COMMA  &kp ES_DOT  &kp ES_MINUS    &kp ES_SQT
&kp C_MUTE        &kp LEFT_GUI  &kp LEFT_ALT  &mo 1     &kp ES_SPACE  &kp ENTER    &kp ENTER        &kp ENTER  &kp ES_SPACE  &mo 2         &kp RALT    &kp DELETE
            >;

            display-name = "L0";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_1 {
            bindings = <
&kp PRINTSCREEN  &kp F1  &kp F2                  &kp F3         &kp F4                   &kp F5      &mmv MOVE_UP     &kp F6     &kp F7    &kp F8      &kp F9     &kp F10  &kp F11
&trans           &trans  &mkp LCLK               &mkp MCLK      &mkp RCLK                &mkp MB4    &mmv MOVE_DOWN   &kp PG_UP  &kp END   &kp UP      &kp HOME   &trans   &kp F12
&trans           &trans  &kp LC(LG(LEFT_ARROW))  &kp LC(LG(D))  &kp LC(LG(RIGHT_ARROW))  &mkp MB5    &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT  &kp DOWN    &kp RIGHT  &trans   &trans
&trans           &trans  &trans                  &trans         &trans                   &trans      &mmv MOVE_RIGHT  &trans     &trans    &kp INSERT  &trans     &trans   &trans
&kp C_MUTE       &trans  &trans                  &trans         &trans                   &trans      &mkp MCLK        &trans     &trans    &trans      &trans     &trans
            >;

            display-name = "L1";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&kp ES_MASCULINE_ORDINAL_INDICATOR  &kp ES_FEMININE_ORDINAL_INDICATOR  &kp ES_AT_SIGN    &kp ES_TILDE         &kp ES_HASH              &kp ES_DOLLAR               &mmv MOVE_UP     &kp ES_EQUAL  &kp ES_PERCENT    &kp ES_TILDE  &kp ES_NOT    &trans             &kp ES_UMLAUT
&kp ES_AMPERSAND                    &kp ES_PIPE                        &kp ES_SLASH      &kp ES_BACKSLASH     &kp ES_LEFT_PARENTHESIS  &kp ES_RIGHT_PARENTHESIS    &mmv MOVE_DOWN   &kp ES_CARET  &kp ES_ASTERISK   &kp ES_GRAVE  &kp ES_ACUTE  &kp ES_SQT         &kp ES_DOUBLE_QUOTES
&kp ES_INVERTED_EXCLAMATION         &kp ES_EXCLAMATION                 &kp ES_LESS_THAN  &kp ES_GREATER_THAN  &kp ES_LEFT_BRACKET      &kp ES_RIGHT_BRACKET        &mmv MOVE_LEFT   &kp ES_MINUS  &kp ES_PLUS       &trans        &trans        &trans             &trans
&kp ES_INVERTED_QUESTION            &kp ES_QUESTION                    &trans            &trans               &kp ES_LEFT_BRACE        &kp ES_RIGHT_BRACE          &mmv MOVE_RIGHT  &kp ES_COLON  &kp ES_SEMICOLON  &trans        &trans        &kp ES_UNDERSCORE  &trans
&trans                              &trans                             &trans            &trans               &trans                   &trans                      &mkp LCLK        &trans        &trans            &trans        &trans        &trans
            >;

            display-name = "L2";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans           &trans           &trans             &trans  &trans  &trans                          &trans                             &trans                             &trans  &trans
&trans  &trans  &trans  &trans           &trans           &trans             &trans  &trans  &trans                          &trans                             &trans                             &trans  &trans
&trans  &trans  &trans  &rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD    &trans  &trans  &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_COLOR_HSB(272,100,48)  &rgb_ug RGB_COLOR_HSB(163,100,50)  &trans  &trans
&trans  &trans  &trans  &trans           &rgb_ug RGB_EFF  &rgb_ug RGB_EFR    &trans  &trans  &trans                          &trans                             &trans                             &trans  &trans
&trans  &trans  &trans  &trans           &trans           &trans             &trans  &trans  &trans                          &trans                             &trans                             &trans
            >;

            display-name = "L3";
            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Layer_3 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
